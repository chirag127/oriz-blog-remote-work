---
/*
 * TimezoneStrip — the signature element of "Off-Grid".
 *
 * A live row of city clocks (IBM Plex Mono) led by an availability status dot,
 * the two artifacts every remote freelancer lives inside. Renders a static
 * snapshot server-side (so it's meaningful without JS) and a tiny inline
 * script ticks each clock to its real local time. The status is derived from
 * the primary desk's local hour: working (mint) during the day, focus (amber)
 * in the evening, away (grey) overnight.
 *
 * Reduced-motion: the dot never pulses; clocks still tick (a clock that
 * doesn't move is worse than one that does).
 */

type Zone = { city: string; tz: string; primary?: boolean }

const zones: Zone[] = [
  { city: 'BLR', tz: 'Asia/Kolkata', primary: true },
  { city: 'LIS', tz: 'Europe/Lisbon' },
  { city: 'SFO', tz: 'America/Los_Angeles' },
]

function timeIn(tz: string): { hhmm: string; hour: number } {
  const parts = new Intl.DateTimeFormat('en-GB', {
    timeZone: tz,
    hour: '2-digit',
    minute: '2-digit',
    hour12: false,
  }).formatToParts(new Date())
  const h = parts.find((p) => p.type === 'hour')?.value ?? '00'
  const m = parts.find((p) => p.type === 'minute')?.value ?? '00'
  return { hhmm: `${h}:${m}`, hour: Number(h) }
}

function statusFor(hour: number): { key: string; label: string } {
  if (hour >= 9 && hour < 18) return { key: 'working', label: 'working' }
  if (hour >= 18 && hour < 23) return { key: 'focus', label: 'in focus' }
  return { key: 'away', label: 'away' }
}

const primary = zones.find((z) => z.primary) ?? zones[0]
const primaryTime = timeIn(primary.tz)
const status = statusFor(primaryTime.hour)
const rendered = zones.map((z) => ({ ...z, ...timeIn(z.tz) }))
---

<div
  class="tz-strip"
  data-status={status.key}
  role="status"
  aria-label={`Status: ${status.label} in ${primary.city}`}
>
  <span class="tz-status">
    <span class="tz-dot" aria-hidden="true"></span>
    <span class="tz-status-label mono">{status.label}</span>
  </span>
  <span class="tz-clocks">
    {rendered.map((z, i) => (
      <>
        {i > 0 && <span class="tz-sep mono" aria-hidden="true">·</span>}
        <span class="tz-clock mono" data-tz={z.tz} class:list={[{ 'is-primary': z.primary }]}>
          <span class="tz-city">{z.city}</span>
          <span class="tz-time">{z.hhmm}</span>
        </span>
      </>
    ))}
  </span>
</div>

<script>
  // Tick every clock to its real local time; recompute the status from the
  // primary zone's hour. Runs once immediately, then on the minute.
  function fmt(tz: string) {
    const p = new Intl.DateTimeFormat('en-GB', {
      timeZone: tz,
      hour: '2-digit',
      minute: '2-digit',
      hour12: false,
    }).formatToParts(new Date())
    const h = p.find((x) => x.type === 'hour')?.value ?? '00'
    const m = p.find((x) => x.type === 'minute')?.value ?? '00'
    return { hhmm: `${h}:${m}`, hour: Number(h) }
  }
  function statusKey(hour: number) {
    if (hour >= 9 && hour < 18) return ['working', 'working']
    if (hour >= 18 && hour < 23) return ['focus', 'in focus']
    return ['away', 'away']
  }
  function tick() {
    document.querySelectorAll<HTMLElement>('.tz-strip').forEach((strip) => {
      let primaryHour = 0
      strip.querySelectorAll<HTMLElement>('.tz-clock').forEach((clock) => {
        const tz = clock.dataset.tz
        if (!tz) return
        const { hhmm, hour } = fmt(tz)
        const t = clock.querySelector('.tz-time')
        if (t) t.textContent = hhmm
        if (clock.classList.contains('is-primary')) primaryHour = hour
      })
      const [key, label] = statusKey(primaryHour)
      strip.dataset.status = key
      const l = strip.querySelector('.tz-status-label')
      if (l) l.textContent = label
    })
  }
  tick()
  // align next update to the top of the minute, then every 60s
  const ms = (60 - new Date().getSeconds()) * 1000
  setTimeout(() => {
    tick()
    setInterval(tick, 60_000)
  }, ms)
</script>

<style>
  .tz-strip {
    --st: var(--mist-mute);
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
    flex-wrap: wrap;
    padding: 0.55rem 0.9rem;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: color-mix(in oklab, var(--paper-2) 70%, transparent);
  }
  .tz-strip[data-status='working'] { --st: var(--live); }
  .tz-strip[data-status='focus'] { --st: var(--signal); }
  .tz-strip[data-status='away'] { --st: var(--mist-mute); }

  .tz-status {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }
  .tz-dot {
    width: 9px;
    height: 9px;
    border-radius: 999px;
    background: var(--st);
    box-shadow: 0 0 0 0 color-mix(in oklab, var(--st) 60%, transparent);
    flex: 0 0 auto;
  }
  @media (prefers-reduced-motion: no-preference) {
    .tz-strip[data-status='working'] .tz-dot,
    .tz-strip[data-status='focus'] .tz-dot {
      animation: tz-ping 2.6s var(--ease-out, ease-out) infinite;
    }
  }
  @keyframes tz-ping {
    0% { box-shadow: 0 0 0 0 color-mix(in oklab, var(--st) 55%, transparent); }
    70% { box-shadow: 0 0 0 7px color-mix(in oklab, var(--st) 0%, transparent); }
    100% { box-shadow: 0 0 0 0 color-mix(in oklab, var(--st) 0%, transparent); }
  }
  .tz-status-label {
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--st);
    font-weight: 500;
  }
  .tz-clocks {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    flex-wrap: wrap;
  }
  .tz-clock {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    font-size: 12.5px;
    letter-spacing: 0.02em;
    color: var(--ink-mute);
  }
  .tz-clock.is-primary { color: var(--ink); }
  .tz-city {
    font-size: 10px;
    letter-spacing: 0.14em;
    color: var(--ink-mute);
  }
  .tz-clock.is-primary .tz-city { color: var(--st); }
  .tz-time { font-variant-numeric: tabular-nums; }
  .tz-sep { color: var(--rule-strong); }
</style>
