---
import HeaderControls from '~/components/HeaderControls.tsx'
import StatusBar from '~/components/StatusBar.astro'
import StatusBanner from '~/components/StatusBanner.astro'
/*
 * Header — slim workspace utility bar (DASHBOARD/KANBAN shell).
 *
 *   ┌──────────────────────────────────────────────────────────────────┐
 *   │ ● Off-Grid · workspace   [working · BLR 14:20 · LIS · SFO]   ⌘K … │
 *   └──────────────────────────────────────────────────────────────────┘
 *
 * NOT a magazine masthead: no centered LATEST/SERIES/TAGS/ABOUT link row.
 * Left = brand mark. Middle = live availability status bar (the workspace's
 * "who's here" indicator). Right = search/rss/overflow. 48px, sticky.
 * All section navigation lives on the board (columns) + the overflow menu.
 */
import Wordmark from '~/components/Wordmark.astro'
---

<StatusBanner />
<header class="deck-bar" transition:persist="deck-bar">
  <div class="deck-bar-inner">
    <div class="deck-brand">
      <Wordmark subtitle="workspace" size={17} href="/" />
    </div>
    <div class="deck-status">
      <StatusBar />
    </div>
    <div class="deck-controls">
      <HeaderControls client:idle />
    </div>
  </div>
</header>

<style>
  .deck-bar {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in oklab, var(--paper) 88%, transparent);
    backdrop-filter: saturate(160%) blur(10px);
    -webkit-backdrop-filter: saturate(160%) blur(10px);
    border-bottom: 1px solid var(--rule);
  }
  .deck-bar-inner {
    height: 48px;
    display: flex;
    align-items: center;
    gap: 1rem;
    max-width: var(--container-page, 1100px);
    margin-inline: auto;
    padding-inline: clamp(0.75rem, 3vw, 1.5rem);
  }
  .deck-brand {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
  }
  .deck-status {
    flex: 1 1 auto;
    display: none;
    justify-content: center;
    min-width: 0;
  }
  @media (min-width: 860px) {
    .deck-status { display: inline-flex; }
  }
  .deck-controls {
    flex: 0 0 auto;
    margin-left: auto;
    display: inline-flex;
    align-items: center;
  }
</style>
