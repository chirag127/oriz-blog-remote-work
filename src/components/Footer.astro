---
/*
 * Off-Grid Footer — compact workspace strip (DASHBOARD/KANBAN shell).
 *
 * NOT a 4-column magazine footer. One quiet horizontal bar: the workspace
 * "sign-off" line (live-dot + one plain-spoken line) on the left, a flat inline
 * link rail on the right (board-lane shortcuts + rss). Legal footer below.
 */
import LegalFooter from '~/components/chrome/legal/LegalFooter.astro'
---
<footer class="deck-foot" role="contentinfo">
  <div class="deck-foot-inner">
    <p class="deck-foot-sign">
      <span class="deck-foot-dot" aria-hidden="true"></span>
      The work travels. The desk doesn't have to.
    </p>
    <nav class="deck-foot-nav" aria-label="Footer">
      <a href="/blog/">Log</a>
      <a href="/series/">Series</a>
      <a href="/tags/">Topics</a>
      <a href="/now/">Now</a>
      <a href="/about/">About</a>
      <a href="/rss.xml" class="deck-foot-rss mono">rss</a>
    </nav>
  </div>
  <LegalFooter
    github="https://github.com/chirag127/oriz-blog-remote-work"
    appName="Off-Grid"
    bio="Remote work and freelancing, written by someone who files the invoices."
    rss="/rss.xml"
  />
</footer>
<style>
  .deck-foot {
    margin-top: 4rem;
    background: var(--paper-2);
    color: var(--ink);
    border-top: 1px solid var(--rule);
  }
  .deck-foot-inner {
    max-width: var(--container-page, 1100px);
    margin: 0 auto;
    padding: 1.5rem clamp(0.75rem, 3vw, 1.5rem);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 1.5rem;
    border-bottom: 1px solid var(--rule);
  }
  .deck-foot-sign {
    margin: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-display, 'Fraunces', Georgia, serif);
    font-weight: 560;
    font-size: clamp(1rem, 2vw, 1.25rem);
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  .deck-foot-dot {
    width: 9px; height: 9px; border-radius: 999px; background: var(--live); flex: 0 0 auto;
  }
  .deck-foot-nav {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 1rem;
  }
  .deck-foot-nav a {
    font-family: var(--font-mono, ui-monospace);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-mute);
    text-decoration: none;
  }
  .deck-foot-nav a:hover { color: var(--accent); }
  .deck-foot-rss { text-transform: lowercase; letter-spacing: 0.04em; color: var(--signal); }
</style>
