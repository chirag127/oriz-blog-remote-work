---
import SeriesSpine from '~/components/SeriesSpine.astro'
/**
 * /  — "Off-Grid" board homepage (remote work & freelancing).
 *
 * DASHBOARD/KANBAN archetype. A productivity board, not a magazine grid:
 * a thin thesis strip up top, then a three-lane board —
 *
 *   NOW      | READING          | TOPICS
 *   ----------------------------------------------
 *   lead +   | recent log       | desks (colour
 *   series   | entries as       | markers) + series
 *   in flight| ticket rows      | index + archive
 *
 * Each lane is a column with a header + count chip, like a kanban board. Ticket
 * rows carry a left status marker (desk colour). Collapses to stacked lanes on
 * narrow screens. No card grid, no centered top-nav.
 */
import BaseLayout from '~/layouts/BaseLayout.astro'
import {
  getCategoriesWithCounts,
  getPostsInSeries,
  getPublishedPosts,
  getSeriesWithCounts,
  postVertical,
  readingTimeFor,
  slugifyTag,
  verticalFor,
  verticalLabel,
} from '~/lib/blog'
import { SITE_CONFIG } from '~/lib/config'

const allPosts = await getPublishedPosts()
const lead = allPosts[0]
const recentPosts = allPosts.slice(1, 9)

const seriesAll = await getSeriesWithCounts()
type InProgress = {
  name: string
  slug: string
  total: number
  published: number
  current: number
  latest: Date
}
const inProgress: InProgress[] = []
for (const { series, count } of seriesAll.slice(0, 3)) {
  const parts = await getPostsInSeries(series)
  const latest = parts.reduce(
    (max, p) => (p.data.pubDate > max ? p.data.pubDate : max),
    parts[0].data.pubDate,
  )
  const explicitMax = parts.reduce((mx, p) => {
    const v = typeof p.data.part === 'number' ? p.data.part : Number(p.data.part)
    return Number.isFinite(v) ? Math.max(mx, v) : mx
  }, 0)
  const total = Math.max(count, explicitMax, count + 1)
  inProgress.push({
    name: series,
    slug: slugifyTag(series),
    total,
    published: count,
    current: count,
    latest,
  })
}
inProgress.sort((a, b) => b.latest.valueOf() - a.latest.valueOf())

const cats = await getCategoriesWithCounts()

const leadVertical = lead ? postVertical(lead) : 'personal'
const leadRt = lead ? (lead.data.readingTime ?? readingTimeFor(lead)) : ''

function ago(date: Date): string {
  const days = Math.floor((Date.now() - date.valueOf()) / 86_400_000)
  if (days < 1) return 'today'
  if (days === 1) return '1d'
  if (days < 30) return `${days}d`
  const months = Math.floor(days / 30)
  if (months < 12) return `${months}mo`
  const years = Math.floor(days / 365)
  return `${years}y`
}

const totalPosts = allPosts.length

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: SITE_CONFIG.title,
  url: `${SITE_CONFIG.url}/`,
  description: SITE_CONFIG.description,
  author: { '@type': 'Person', name: SITE_CONFIG.author.name, url: SITE_CONFIG.author.url },
}
---

<BaseLayout title="Off-Grid — the remote-work board" description={SITE_CONFIG.description} jsonLd={jsonLd}>
  <div class="board-wrap">
    {/* Thesis strip — one line of intent above the board. */}
    <section class="thesis" aria-label="Introduction">
      <h1 class="thesis-h">A working board for a desk that moves between time zones.</h1>
      <p class="thesis-sub">Remote work and freelancing, written by someone who files the invoices — setting up a room that helps you focus, finding clients who pay on time, and running async so the work travels without you.</p>
    </section>

    {/* The board — three lanes. */}
    <div class="board" role="list" aria-label="Off-Grid board">
      {/* ── Lane 1 · NOW ─────────────────────────────────────────────── */}
      <section class="lane lane-now" role="listitem" aria-labelledby="lane-now-h">
        <header class="lane-head">
          <h2 id="lane-now-h" class="lane-title mono">Now</h2>
          <span class="lane-chip mono">focus</span>
        </header>
        <div class="lane-body">
          {lead && (
            <a class="ticket ticket-lead" href={`/blog/${lead.id}`} data-vertical={leadVertical}>
              <span class="ticket-marker" aria-hidden="true"></span>
              <span class="ticket-tag mono">{verticalLabel(leadVertical)} · lead</span>
              <span class="ticket-title lead-title">{lead.data.title}</span>
              <span class="ticket-dek">{lead.data.description}</span>
              <span class="ticket-meta mono">
                <time datetime={lead.data.pubDate.toISOString()}>{lead.data.pubDate.toISOString().slice(0, 10)}</time>
                <span aria-hidden="true">·</span><span>{leadRt}</span>
              </span>
            </a>
          )}
          {inProgress.length > 0 && (
            <div class="now-series">
              <p class="now-series-h mono">Series in flight</p>
              <ul class="now-series-list">
                {inProgress.map((s) => (
                  <li>
                    <a class="now-series-row" href={`/series/${s.slug}/`}>
                      <span class="now-series-name">{s.name}</span>
                      <SeriesSpine total={s.total} published={s.published} current={s.current} size="sm" />
                      <span class="now-series-meta mono">{s.published}/{s.total} · {ago(s.latest)}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </section>

      {/* ── Lane 2 · READING ─────────────────────────────────────────── */}
      <section class="lane lane-reading" role="listitem" aria-labelledby="lane-reading-h">
        <header class="lane-head">
          <h2 id="lane-reading-h" class="lane-title mono">Reading</h2>
          <span class="lane-chip mono">{totalPosts}</span>
        </header>
        <div class="lane-body">
          <ul class="reading-list">
            {recentPosts.map((p) => (
              <li class="reading-item" data-vertical={postVertical(p)}>
                <a class="ticket ticket-read" href={`/blog/${p.id}`}>
                  <span class="ticket-marker" aria-hidden="true"></span>
                  <span class="ticket-row-top mono">
                    <span class="ticket-tag">{verticalLabel(postVertical(p))}</span>
                    <time datetime={p.data.pubDate.toISOString()}>{p.data.pubDate.toISOString().slice(0, 10)}</time>
                  </span>
                  <span class="ticket-title">{p.data.title}</span>
                  <span class="ticket-meta mono">{p.data.readingTime ?? readingTimeFor(p)}</span>
                </a>
              </li>
            ))}
          </ul>
          <a class="lane-all" href="/archive/">Open the full log →</a>
        </div>
      </section>

      {/* ── Lane 3 · TOPICS ──────────────────────────────────────────── */}
      <section class="lane lane-topics" role="listitem" aria-labelledby="lane-topics-h">
        <header class="lane-head">
          <h2 id="lane-topics-h" class="lane-title mono">Topics</h2>
          <span class="lane-chip mono">{cats.length}</span>
        </header>
        <div class="lane-body">
          <ul class="topics-list">
            {cats.map((c) => (
              <li class="topics-item" data-vertical={verticalFor(c.category)}>
                <a class="topics-row" href={`/categories/${slugifyTag(c.category)}/`}>
                  <span class="topics-marker" aria-hidden="true"></span>
                  <span class="topics-name">{c.category}</span>
                  <span class="topics-count mono">{c.count}</span>
                </a>
              </li>
            ))}
          </ul>
          <nav class="topics-quick" aria-label="Quick links">
            <a href="/series/">All series →</a>
            <a href="/tags/">All tags →</a>
            <a href="/now/">What I'm on now →</a>
          </nav>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .board-wrap {
    max-width: var(--container-page, 1100px);
    margin-inline: auto;
    padding-inline: clamp(0.75rem, 3vw, 1.5rem);
    padding-block: clamp(1.75rem, 4vw, 2.75rem) 1rem;
  }

  /* ── Thesis strip ──────────────────────────────────────────────────── */
  .thesis { max-width: 62ch; margin-bottom: clamp(1.75rem, 4vw, 2.5rem); }
  .thesis-h {
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-variation-settings: "opsz" 72, "SOFT" 40, "WONK" 1;
    font-size: clamp(1.9rem, 4.6vw, 3rem);
    font-weight: 560;
    letter-spacing: -0.025em;
    line-height: 1.06;
    color: var(--ink);
    margin: 0;
    max-width: 20ch;
    text-wrap: balance;
  }
  .thesis-sub {
    font-family: var(--font-body);
    font-size: clamp(1rem, 1.5vw, 1.125rem);
    line-height: 1.55;
    color: var(--ink-mute);
    margin: 1rem 0 0;
  }

  /* ── Board ─────────────────────────────────────────────────────────── */
  .board {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    align-items: start;
  }
  @media (min-width: 720px) {
    .board { grid-template-columns: 1fr 1fr; }
    .lane-now { grid-column: 1 / -1; }
  }
  @media (min-width: 1040px) {
    .board { grid-template-columns: 1.15fr 1fr 0.8fr; }
    .lane-now { grid-column: auto; }
  }

  .lane {
    background: color-mix(in oklab, var(--paper-2) 55%, transparent);
    border: 1px solid var(--rule);
    border-radius: var(--radius-card, 12px);
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .lane-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.75rem 0.9rem;
    border-bottom: 1px solid var(--rule);
  }
  .lane-title {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .lane-chip {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.08em;
    color: var(--signal);
    border: 1px solid var(--rule);
    border-radius: 999px;
    padding: 0.15rem 0.5rem;
  }
  .lane-body { padding: 0.6rem; display: flex; flex-direction: column; gap: 0.5rem; }

  /* ── Ticket (shared) ───────────────────────────────────────────────── */
  .ticket {
    --v: var(--v-personal);
    position: relative;
    display: grid;
    gap: 0.3rem;
    padding: 0.7rem 0.75rem 0.7rem 1rem;
    border-radius: var(--radius-button, 8px);
    background: var(--paper);
    border: 1px solid var(--rule);
    color: var(--ink);
    text-decoration: none;
    transition: border-color var(--dur-fast, 120ms) ease, transform var(--dur-fast, 120ms) ease;
  }
  .ticket[data-vertical='dev'], .reading-item[data-vertical='dev'] .ticket { --v: var(--v-dev); }
  .ticket[data-vertical='finance'], .reading-item[data-vertical='finance'] .ticket { --v: var(--v-finance); }
  .ticket[data-vertical='culture'], .reading-item[data-vertical='culture'] .ticket { --v: var(--v-culture); }
  .ticket[data-vertical='health'], .reading-item[data-vertical='health'] .ticket { --v: var(--v-health); }
  .ticket-marker {
    position: absolute;
    left: 0; top: 0.75rem; bottom: 0.75rem;
    width: 3px;
    border-radius: 999px;
    background: var(--v);
  }
  .ticket:hover { border-color: var(--v); transform: translateY(-1px); }
  .ticket:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  @media (prefers-reduced-motion: reduce) { .ticket { transition: none; } .ticket:hover { transform: none; } }
  .ticket-tag {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--v);
    font-weight: 500;
  }
  .ticket-title {
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.25;
    color: var(--ink);
  }
  .ticket:hover .ticket-title { color: var(--accent); }
  .ticket-dek {
    font-family: var(--font-body);
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--ink-mute);
    display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 3; line-clamp: 3; overflow: hidden;
  }
  .ticket-meta {
    display: inline-flex;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.04em;
    color: var(--ink-mute);
  }

  /* ── Lane NOW ──────────────────────────────────────────────────────── */
  .ticket-lead .lead-title { font-size: clamp(1.25rem, 2.4vw, 1.6rem); }
  .now-series {
    border: 1px solid var(--rule);
    border-radius: var(--radius-button, 8px);
    padding: 0.7rem 0.75rem;
    background: var(--paper);
  }
  .now-series-h {
    margin: 0 0 0.5rem;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-mute);
  }
  .now-series-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.5rem; }
  .now-series-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.25rem 0.75rem;
    color: var(--ink);
    text-decoration: none;
  }
  .now-series-name {
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .now-series-row:hover .now-series-name { color: var(--accent); }
  .now-series-meta { grid-column: 1 / -1; font-size: 10px; color: var(--ink-mute); letter-spacing: 0.04em; }

  /* ── Lane READING ──────────────────────────────────────────────────── */
  .reading-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.5rem; }
  .ticket-read .ticket-row-top {
    display: flex; align-items: center; justify-content: space-between; gap: 0.5rem;
    font-size: 10px; letter-spacing: 0.06em; color: var(--ink-mute);
  }
  .ticket-read .ticket-title { font-size: 0.98rem; }
  .lane-all {
    margin-top: 0.25rem;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    color: var(--ink-mute);
    text-decoration: none;
    padding: 0.3rem 0.25rem;
  }
  .lane-all:hover { color: var(--accent); }

  /* ── Lane TOPICS ───────────────────────────────────────────────────── */
  .topics-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
  .topics-item {
    --v: var(--v-personal);
    border-bottom: 1px solid color-mix(in oklab, var(--rule) 70%, transparent);
  }
  .topics-item:last-child { border-bottom: 0; }
  .topics-item[data-vertical='dev'] { --v: var(--v-dev); }
  .topics-item[data-vertical='finance'] { --v: var(--v-finance); }
  .topics-item[data-vertical='culture'] { --v: var(--v-culture); }
  .topics-item[data-vertical='health'] { --v: var(--v-health); }
  .topics-row {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.55rem 0.35rem;
    color: var(--ink);
    text-decoration: none;
  }
  .topics-marker { width: 8px; height: 8px; border-radius: 2px; background: var(--v); flex: 0 0 auto; }
  .topics-name {
    font-family: var(--font-display);
    font-size: 0.98rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    flex: 1 1 auto;
    min-width: 0;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .topics-row:hover .topics-name { color: var(--v); }
  .topics-count { font-family: var(--font-mono); font-size: 11px; color: var(--ink-mute); font-variant-numeric: tabular-nums; }
  .topics-quick {
    display: flex; flex-direction: column; gap: 0.35rem;
    margin-top: 0.6rem; padding-top: 0.6rem; border-top: 1px solid var(--rule);
  }
  .topics-quick a {
    font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.04em;
    color: var(--ink-mute); text-decoration: none;
  }
  .topics-quick a:hover { color: var(--accent); }
</style>
